# Upstash for Redis (Vercel Marketplace). Add the integration to the project, then run
# `vercel env pull .env.development.local` to fill these in — the visitor counter simply
# hides itself while they are empty, so local development needs none of them.
# The integration sets one pair or the other depending on the store; either works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
